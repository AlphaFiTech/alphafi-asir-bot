# AlphaFi ASIR_bot Configuration Example
# Copy this file to .env and fill in the values

# --- Required ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
BETTER_STACK_API_TOKEN=your_better_stack_api_v3_token_here
ESCALATION_POLICY_ID=your_policy_id_here

# --- Optional ---
# Comma-separated list of Telegram User IDs (e.g. 12345,67890)
ALLOWED_USER_IDS=

# Email address used for Better Stack incident requester
REQUESTER_EMAIL=admin@alphafi.xyz
